# Pick ONE provider. Only that key is required.
MODEL_PROVIDER=mock
# MODEL_PROVIDER=openai | anthropic | gemini | ollama | mock
MODEL_NAME=gpt-4o-mini

# OpenAI (if MODEL_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Anthropic (if MODEL_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_NAME=claude-3-5-haiku-latest

# Gemini (if MODEL_PROVIDER=gemini, uses OpenAI-compatible endpoint)
# GOOGLE_API_KEY=...
# MODEL_NAME=gemini-1.5-flash

# Ollama local, no key needed (if MODEL_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434
# MODEL_NAME=llama3.1:8b

ERP_BASE_URL=http://localhost:8000
ERP_DB_PATH=mock_env/erp.db
INBOX_DIR=mock_env/inbox
MAX_STEPS=15
REQUIRE_APPROVAL=true
